{
  "name": "dsh-guikit",
  "description": "DSH GUI Toolkit — Windows desktop control tools for DeepSeek Harness (DSH): screen layout, annotated screenshot, single-window capture, click / drag / type / key / scroll, semantic verification, window management, and UI Automation structured queries. Thirteen model tools, zero external dependencies, no resident service.",
  "version": "0.6.2",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.2-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gezi-wen/dsh-guikit.git"
  },
  "homepage": "https://github.com/gezi-wen/dsh-guikit#readme",
  "bugs": {
    "url": "https://github.com/gezi-wen/dsh-guikit/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "plugin",
    "gui",
    "automation",
    "desktop-automation",
    "computer-use",
    "screen-capture",
    "screenshot",
    "uiautomation",
    "accessibility",
    "windows",
    "windows-automation",
    "mouse",
    "keyboard"
  ]
}
